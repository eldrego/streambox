# ── Module Federation remote URLs ────────────────────────────────────────────
# In local dev these point to localhost; in Docker Desktop they also use localhost
# (Docker maps container ports to the host, so the browser reaches them via localhost)
VITE_REMOTE_MUSIC_URL=http://localhost:4201/assets/remoteEntry.js
VITE_REMOTE_MOVIES_URL=http://localhost:4202/assets/remoteEntry.js

# ── New Relic Browser Monitoring ─────────────────────────────────────────────
# All values are found in New Relic UI: Browser > (your app) > Application settings
# Must use VITE_ prefix — Vite only exposes VITE_* vars to browser code
VITE_NEW_RELIC_ACCOUNT_ID=
VITE_NEW_RELIC_TRUST_KEY=
VITE_NEW_RELIC_AGENT_ID=
VITE_NEW_RELIC_LICENSE_KEY=
VITE_NEW_RELIC_APP_ID=
